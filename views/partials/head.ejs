<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#171b22">
    <title><%= title ? `${title} · ${appName}` : appName %></title>
    <link rel="stylesheet" href="/css/styles.css">
  </head>
  <body class="<%= locals.bodyClass || '' %>">
    <% if (!locals.hideHeader) { %>
      <header class="site-header">
        <div class="shell header-inner">
          <a class="brand" href="/" aria-label="<%= appName %> home">
            <span class="brand-mark" aria-hidden="true">M</span>
            <span><%= appName %></span>
          </a>
          <nav class="site-nav" aria-label="Primary navigation">
            <a href="/" <%= currentPath === "/" ? 'aria-current="page"' : "" %>>Library</a>
            <% if (isAdmin) { %>
              <a href="/admin" <%= currentPath.startsWith("/admin") ? 'aria-current="page"' : "" %>>Admin</a>
            <% } %>
          </nav>
        </div>
      </header>
    <% } %>
    <% if (flash) { %>
      <div class="shell flash flash-<%= flash.type %>" role="status">
        <%= flash.message %>
      </div>
    <% } %>
