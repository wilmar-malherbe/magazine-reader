<%- include("partials/head", {
  title,
  bodyClass: "viewer-page",
  hideHeader: true,
  hideFooter: true
}) %>

<main
  id="magazine-viewer"
  class="viewer-shell"
  data-pdf-url="/media/pdfs/<%= magazine.pdf_filename %>"
  data-title="<%= magazine.title %>"
  data-orientation="loading"
  data-layout="loading"
  data-current-page="1"
>
  <header class="viewer-header">
    <a class="viewer-back" href="/" aria-label="Back to library">
      <span aria-hidden="true">←</span>
      <span>Library</span>
    </a>
    <div class="viewer-title">
      <h1><%= magazine.title %></h1>
      <% if (magazine.issue_label || magazine.issue_date) { %>
        <p>
          <%= magazine.issue_label || "" %>
          <% if (magazine.issue_label && magazine.issue_date) { %> · <% } %>
          <% if (magazine.issue_date) { %><%= formatDate(magazine.issue_date) %><% } %>
        </p>
      <% } %>
    </div>
    <% if (allowPublicDownload) { %>
      <a class="viewer-download" href="/media/pdfs/<%= magazine.pdf_filename %>?download=1">
        <span aria-hidden="true">↓</span>
        <span>Download</span>
      </a>
    <% } else { %>
      <span class="viewer-header-spacer" aria-hidden="true"></span>
    <% } %>
    <details class="reader-info" open>
      <summary>About this issue and text preview</summary>
      <section class="reader-info-panel" aria-label="Document information">
        <h2><%= magazine.title %></h2>
        <% if (magazine.description) { %><p><%= magazine.description %></p><% } %>
        <p><a href="/media/pdfs/<%= magazine.pdf_filename %>">Open the original PDF</a> to read the complete document in your browser.</p>
        <noscript><p>The flipbook needs JavaScript. The PDF and text preview remain available here.</p></noscript>
        <% if (textPreview.length) { %>
          <h3>Text preview</h3>
          <p class="reader-preview-note">Extracted from the first six pages. Use the original PDF for complete content and formatting.</p>
          <% textPreview.forEach(paragraph => { %><p><%= paragraph %></p><% }) %>
        <% } %>
      </section>
    </details>
  </header>

  <section class="viewer-stage" id="viewer-stage" aria-label="<%= magazine.title %> reader">
    <div class="book-zoom-layer" id="book-zoom-layer">
      <div id="flipbook" aria-live="off"></div>
    </div>
    <div class="viewer-loading" id="viewer-loading" role="status">
      <span class="loading-spinner" aria-hidden="true"></span>
      <span>Opening magazine…</span>
    </div>
    <div class="viewer-error" id="viewer-error" role="alert" hidden>
      <strong>We couldn’t open this magazine.</strong>
      <span>Try refreshing the page or downloading the PDF.</span>
    </div>
  </section>

  <nav class="viewer-toolbar" aria-label="Magazine controls">
    <div class="toolbar-group">
      <button id="previous-page" class="tool-button" type="button" aria-label="Previous page" disabled>
        <span aria-hidden="true">←</span>
      </button>
      <div id="page-status" class="page-status" role="status" aria-live="polite">Page 1</div>
      <button id="next-page" class="tool-button" type="button" aria-label="Next page" disabled>
        <span aria-hidden="true">→</span>
      </button>
    </div>
    <div
      id="layout-switch"
      class="toolbar-group layout-switch"
      role="group"
      aria-label="Page layout"
      hidden
    >
      <button
        id="layout-single"
        class="layout-button"
        type="button"
        aria-label="Show one page at a time"
        aria-pressed="false"
      >
        1 page
      </button>
      <button
        id="layout-spread"
        class="layout-button"
        type="button"
        aria-label="Show a two-page spread"
        aria-pressed="false"
      >
        2 pages
      </button>
    </div>
    <div class="toolbar-group">
      <button id="zoom-out" class="tool-button" type="button" aria-label="Zoom out" disabled>
        <span aria-hidden="true">−</span>
      </button>
      <span id="zoom-status" class="zoom-status" aria-live="polite">100%</span>
      <button id="zoom-in" class="tool-button" type="button" aria-label="Zoom in" disabled>
        <span aria-hidden="true">+</span>
      </button>
      <button id="fullscreen" class="tool-button" type="button" aria-label="Enter fullscreen">
        <span aria-hidden="true">⛶</span>
      </button>
    </div>
  </nav>

  <p id="viewer-announcement" class="sr-only" aria-live="polite"></p>

  <dialog
    id="layout-choice"
    class="layout-dialog"
    aria-labelledby="layout-choice-title"
    aria-describedby="layout-choice-description"
  >
    <div class="layout-dialog-content">
      <p class="layout-dialog-eyebrow">Reading view</p>
      <h2 id="layout-choice-title">How would you like to read?</h2>
      <p id="layout-choice-description">
        Choose a page layout for this magazine. You can change it later from the toolbar.
      </p>
      <div class="layout-choice-actions">
        <button class="layout-choice-button" type="button" data-layout-choice="single">
          <span class="layout-choice-preview layout-choice-preview-single" aria-hidden="true">
            <span></span>
          </span>
          <span>
            <strong>1 page</strong>
            <small>Focus on one page at a time</small>
          </span>
        </button>
        <button
          class="layout-choice-button layout-choice-button-primary"
          type="button"
          data-layout-choice="spread"
          autofocus
        >
          <span class="layout-choice-preview layout-choice-preview-spread" aria-hidden="true">
            <span></span>
            <span></span>
          </span>
          <span>
            <strong>2 pages</strong>
            <small>Read interior pages as a spread</small>
          </span>
        </button>
      </div>
    </div>
  </dialog>
</main>

<script type="module" src="/js/magazine-viewer.js?v=2"></script>
<%- include("partials/foot", { hideFooter: true }) %>
