{
  "name": "magshelf",
  "version": "1.0.0",
  "private": true,
  "description": "A self-hosted PDF magazine library and responsive flipbook reader.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "test:watch": "node --test --watch test/*.test.js",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "multer": "^2.2.0",
    "page-flip": "^2.0.7",
    "pdfjs-dist": "^6.1.200",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "pdf-lib": "^1.17.1",
    "supertest": "^7.2.2"
  }
}
